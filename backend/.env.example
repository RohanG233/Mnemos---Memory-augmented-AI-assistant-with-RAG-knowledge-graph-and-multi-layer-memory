# ============================================================
# ACAI Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# -----------------------------------------------
# MongoDB Atlas
# -----------------------------------------------
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<AppName>
MONGODB_DATABASE=acai

# -----------------------------------------------
# JWT
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------
# Google OAuth 2.0
# From: console.cloud.google.com → APIs & Services → Credentials
# -----------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# -----------------------------------------------
# Frontend (where browser lands after OAuth)
# -----------------------------------------------
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------
# Ollama / LLM
# -----------------------------------------------
OLLAMA_URL=http://localhost:11434/api/chat
LLM_MODEL=hf.co/bartowski/Llama-3.2-1B-Instruct-GGUF:latest
LLM_TIMEOUT=120

# -----------------------------------------------
# Storage
# -----------------------------------------------
CHROMA_PATH=./data/chroma_db
GRAPH_DIRECTORY=./data/graphs

# -----------------------------------------------
# Cookies
# Set false for local HTTP dev, true for production HTTPS
# -----------------------------------------------
COOKIE_SECURE=false
